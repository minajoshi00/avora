# ============================================================
# AVORA - Environment Variables
# ============================================================
# Copy this file to .env and fill in your API keys
# DO NOT commit .env to version control
# ============================================================

# AI Provider API Keys
# ---------------------

# Google Gemini API Key
# Get yours at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: Specify AI models (defaults shown if not set)
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile

# Image Generation API Key
# -------------------------
# Pollinations.ai API key for image generation
# Get yours at: https://pollinations.ai/
POLLINATIONS_API_KEY=your_pollinations_api_key_here

# Weather API Key
# ----------------
# OpenWeatherMap API key for weather features
# Get yours at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Gmail Configuration (Optional)
# ------------------------------
# Gmail is optional and configured via Settings UI
# No environment variables needed for Gmail

# ============================================================
# Notes:
# - Only GEMINI_API_KEY is required for basic functionality
# - Groq provides fallback AI if Gemini fails
# - Other keys enable optional features
# - Leave keys empty to disable specific features
# ============================================================