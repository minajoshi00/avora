# AVORA Analytics server configuration (SERVER-SIDE ONLY — never ship to the browser)
# Copy to .env. This file is git-ignored.

# Port the analytics API listens on (platforms like Render override with PORT).
AVORA_ANALYTICS_PORT=8787

# FULL admin key. NEVER exposed to the frontend. Used for privileged access.
AVORA_ANALYTICS_ADMIN_KEY=avora_68rp20EZUlnio5YGaS3xMgtVhDCduWHzFkRNweT9yPB1mfJs

# LOW-PRIVILEGE read token. This is the ONLY analytics secret the frontend may
# hold (as VITE_ANALYTICS_VIEW_KEY). It is safe to ship. Keep it DIFFERENT from
# the admin key so a leaked view key cannot grant admin access.
AVORA_ANALYTICS_VIEW_KEY=avora_view_public_token_change_me

# NEVER enable seeding in production. Seeding is dev-only.
AVORA_ANALYTICS_SEED=false

# Optional: override DB location (e.g. an absolute persistent-disk path).
# AVORA_ANALYTICS_DB=/var/data/analytics.db
