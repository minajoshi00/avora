# AVORA frontend environment (PRODUCTION-SAFE)
# Copy to .env. NEVER put the admin key (AVORA_ANALYTICS_ADMIN_KEY) here.
# This file is git-ignored and safe to commit reference values only.

# Base URL for the analytics API. In production use the same-origin path.
VITE_ANALYTICS_API=/api

# LOW-PRIVILEGE read/view token for the analytics dashboard. This is NOT the
# admin key and is safe to ship in client JavaScript. Set it to match
# AVORA_ANALYTICS_VIEW_KEY on the analytics server.
VITE_ANALYTICS_VIEW_KEY=avora_view_public_token_change_me
